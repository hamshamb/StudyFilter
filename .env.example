# Frontend authentication (required)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
VITE_CLERK_PROXY_URL=/api/__clerk

# Server authentication (required for signed-in features)
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# PostgreSQL (required for persisted progress, plans, analytics, and library data)
DATABASE_URL=postgresql://user:password@localhost:5432/studyfilter

# AI study answers (optional; deterministic/local fallbacks remain available)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Email and feedback (optional)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
FEEDBACK_FROM=StudyFilter <feedback@example.com>
SUPPORT_EMAIL=support@example.com

# Local service defaults
PORT=8080
BASE_PATH=/
LOG_LEVEL=info
